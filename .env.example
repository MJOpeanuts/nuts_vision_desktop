# Nuts Vision runs locally with SQLite: no database server is needed.
# Copy this file to .env only if you want to change the defaults.

# Technical folder (database/, logs/).
# Default on Windows: %LOCALAPPDATA%\DataPeanuts\NutsVision
# NUTS_VISION_DATA_DIR=

# Images and analysis results folder.
# Default on Windows: <your Pictures folder>\NutsVision
# NUTS_VISION_OUTPUT_DIR=

# Streamlit server port (default: 8501)
# Change this if port 8501 is already in use
STREAMLIT_PORT=8501
